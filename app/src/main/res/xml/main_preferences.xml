<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
	<ListPreference
		android:key="game_speed"
		android:title="@string/game_speed_title"
		android:summary="@string/game_speed_summary"
		android:defaultValue="1"
		android:entries="@array/game_speeds"
		android:entryValues="@array/game_speed_values"
		android:icon="@drawable/ic_speed" />
	<CheckBoxPreference
		android:key="elimination"
		android:title="@string/elimination_title"
		android:summary="@string/elimination_summary"
		android:defaultValue="false"
		android:icon="@drawable/ic_deck" />
	<CheckBoxPreference
		android:key="computer_4th"
		android:title="@string/computer_4th_title"
		android:summary="@string/computer_4th_summary"
		android:defaultValue="false"
		android:icon="@drawable/ic_robot" />
	<CheckBoxPreference
		android:key="face_up"
		android:title="@string/face_up_title"
		android:summary="@string/face_up_summary"
		android:defaultValue="false"
		android:icon="@drawable/ic_faceup" />
	<CheckBoxPreference
		android:key="family_friendly"
		android:title="@string/family_friendly_title"
		android:summary="@string/family_friendly_summary"
		android:defaultValue="true"
		android:icon="@drawable/ic_family_friendly" />
	<CheckBoxPreference
		android:key="haptics"
		android:title="@string/haptics_title"
		android:summary="@string/haptics_summary"
		android:defaultValue="true" />
	<CheckBoxPreference
		android:key="auto_uno"
		android:title="@string/auto_uno_title"
		android:summary="@string/auto_uno_summary"
		android:defaultValue="false"
		android:icon="@drawable/ic_cheat" />
	<ListPreference
		android:key="jump_in_ms"
		android:title="@string/jump_in_title"
		android:summary="@string/jump_in_summary"
		android:defaultValue="2000"
		android:entries="@array/jump_in_times"
		android:entryValues="@array/jump_in_values"
		android:icon="@drawable/ic_speed" />
	<!-- Navigate to players preferences fragment -->
	<androidx.preference.Preference
		android:key="players_prefs"
		android:title="@string/players"
		android:summary="@string/players_summary"
		android:fragment="com.smorgasbork.hotdeath.Prefs$PlayersPrefsFragment"
		android:icon="@drawable/ic_opponents" />
</PreferenceScreen>