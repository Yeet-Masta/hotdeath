<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
	android:fitsSystemWindows="true"
    android:paddingLeft="30dip"
    android:paddingRight="30dip"
    android:paddingBottom="30dip"
    android:paddingTop="80dip"
    android:background="@drawable/splash"
    android:orientation="horizontal"
    >
    <LinearLayout 
    	android:id="@+id/linearLayout1"
    	android:orientation="vertical"
	    android:layout_height="wrap_content"
    	android:layout_width="fill_parent"
    	android:layout_gravity="center">

		<ImageButton
			android:src="@drawable/sel_btn_continue"
			android:id="@+id/btn_continue"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:scaleType="center"
			android:background="@null" />

		<ImageButton
			android:src="@drawable/sel_btn_new_game"
			android:id="@+id/btn_new_game"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:scaleType="center"
			android:background="@null" />

		<Button
			android:id="@+id/btn_multiplayer"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="4dp"
			android:layout_marginBottom="4dp"
			android:minWidth="200dp"
			android:background="#99000000"
			android:text="@string/lbl_multiplayer"
			android:textColor="@android:color/white"
			android:textStyle="bold" />

		<ImageButton
			android:src="@drawable/sel_btn_settings"
			android:id="@+id/btn_settings"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:scaleType="center"
			android:background="@null" />

		<ImageButton
			android:src="@drawable/sel_btn_help"
			android:id="@+id/btn_help"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:scaleType="center"
			android:background="@null" />

		<ImageButton
			android:src="@drawable/sel_btn_about"
			android:id="@+id/btn_about"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:scaleType="center"
			android:background="@null" />

		<ImageButton
			android:src="@drawable/sel_btn_exit"
			android:id="@+id/btn_exit"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:scaleType="center"
			android:background="@null" />
    </LinearLayout>
</LinearLayout>
