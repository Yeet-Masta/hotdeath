<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online play through the relay server -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nearby Connections (same-room play) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Nearby still checks location for discovery on Android 13+ (error 8034 without it). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- usesCleartextTraffic: allows ws:// relays (LAN testing); use wss:// on the internet. -->
    <application
        android:icon="@drawable/icon"
        android:usesCleartextTraffic="true">
        <activity android:name=".Main"
                  android:exported="true"
                  android:label="@string/app_name"
                  android:theme="@style/GameTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GameActivity"
                  android:label="@string/app_name"
                  android:theme="@style/GameTheme">
        </activity>
        <activity android:name=".RulesActivity"
                  android:label="@string/dlg_help_title"
                  android:theme="@style/PrefsTheme">
        </activity>
        <activity android:name=".MultiplayerActivity"
                  android:label="@string/mp_title"
                  android:theme="@style/PrefsTheme">
        </activity>
        <activity android:name=".Prefs"
            android:label="@string/settings_title"
            android:theme="@style/PrefsTheme">
        </activity>

    </application>
</manifest>